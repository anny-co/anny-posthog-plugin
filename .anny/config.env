# Single source of truth for the mirror. Change a value, run
# .anny/sync-upstream.sh, commit -- that is the whole configuration story.

UPSTREAM_REPO=https://github.com/PostHog/ai-plugin.git
UPSTREAM_REF=main

# The MCP endpoint. Same host as PostHog, on a path -- the chart routes /mcp to
# the `mcp` Service and everything else to Django. One host means the consent
# page and the MCP metadata are same-origin, which removes the CORS problem a
# separate mcp.* hostname would have.
MCP_URL=https://posthog.anny.cloud/mcp

# The PostHog instance itself. Doubles as the OAuth authorization server: the
# MCP server advertises exactly this host in its RFC 9728 metadata, and Claude
# registers itself there via RFC 7591 dynamic client registration.
POSTHOG_URL=https://posthog.anny.cloud

# Event ingestion host (the HelmRelease's `ingestHost`). Only used by the
# optional Claude-Code-session -> LLM Analytics hook.
POSTHOG_INGEST_URL=https://p.anny.cloud

MARKETPLACE_NAME=anny
PLUGIN_NAME=posthog-anny
REPO_URL=https://github.com/jeremy-anny/anny-posthog-plugin
